# 业务数据底座（只读）
BUSINESS_DB_URL=mysql+pymysql://forgesight_reader:CHANGE_ME@127.0.0.1:3306/forge_sight?charset=utf8mb4

# 平台库（读写，存知识、会话、审计、元数据登记和 Agent 状态）
PLATFORM_DB_URL=postgresql+psycopg2://postgres:CHANGE_ME@127.0.0.1:5432/forge_sight_app

# 仅迁移脚本使用；运行时不需要保留
POSTGRES_ADMIN_DB_URL=postgresql+psycopg2://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# 初始化 MySQL 只读账号时使用，仅限 scripts
ADMIN_DB_URL=mysql+pymysql://root:CHANGE_ME@127.0.0.1:3306/?charset=utf8mb4

# LLM（OpenAI 兼容协议）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=CHANGE_ME
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
# Optional. Leave empty when the model endpoint is directly reachable.
LLM_PROXY_URL=

# 混合检索（规则/BM25 类精确召回 + pgvector 语义召回 + RRF 融合）
# 首次启用前执行：python scripts/rebuild_semantic_index.py
RETRIEVAL_SEMANTIC_ENABLED=false
# 阿里云百炼 OpenAI-compatible Embeddings。生产环境优先使用业务空间专属域名：
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 未配置专属域名时，北京地域可先使用下面的公共端点。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
# text-embedding-v4 官方推荐通用检索使用 1024 维。更换模型或维度后必须全量重建索引。
EMBEDDING_DIMENSIONS=1024
EMBEDDING_SEND_DIMENSIONS=true
# 默认不继承操作系统代理。如确需代理，请填写完整 URL，例如 http://127.0.0.1:7897
EMBEDDING_PROXY_URL=
EMBEDDING_TIMEOUT_SECONDS=8
EMBEDDING_MAX_RETRIES=1
RETRIEVAL_SEMANTIC_CIRCUIT_BREAKER_SECONDS=30
RETRIEVAL_SEMANTIC_TOP_K=20
RETRIEVAL_SEMANTIC_SCORE_THRESHOLD=0.45
RETRIEVAL_RRF_K=60
SEMANTIC_INDEX_WORKER_ENABLED=true
SEMANTIC_INDEX_WORKER_POLL_SECONDS=0.75
SEMANTIC_INDEX_WORKER_LEASE_SECONDS=180
SEMANTIC_INDEX_MAX_ATTEMPTS=3

# Agent 用量与预算
AGENT_MAX_LLM_CALLS=12
AGENT_MAX_RETRY_CALLS=3
AGENT_MAX_INPUT_TOKENS=120000
AGENT_MAX_OUTPUT_TOKENS=16000
AGENT_MAX_TOTAL_TOKENS=136000
AGENT_MAX_ESTIMATED_COST=10
AGENT_MAX_DURATION_SECONDS=300
AGENT_WORKER_ENABLED=true
AGENT_WORKER_POLL_SECONDS=0.75
AGENT_WORKER_LEASE_SECONDS=60
# 灰度/回滚开关：关闭调度仍可读取历史报告；关闭邮件仍保留站内消息
REPORT_SCHEDULER_ENABLED=true
MAIL_WORKER_ENABLED=true
# 关闭后飞书/钉钉周报 PDF 投递 Worker 不再运行，但已排队投递仍保留
IM_PDF_WORKER_ENABLED=true
# 智能异常监测：规则调度、只读执行、站内消息及飞书/钉钉告警投递
MONITORING_WORKER_ENABLED=true
MONITORING_WORKER_LEASE_SECONDS=120
MONITORING_DELIVERY_LEASE_SECONDS=90
OPERATIONS_QUEUE_BACKLOG_WARNING=100

# SQL 执行限制
SQL_MAX_ROWS=10000
SQL_TIMEOUT_SECONDS=30
SQL_EXPLAIN_ENABLED=true
SQL_EXPLAIN_MAX_ESTIMATED_ROWS=500000
SQL_EXPLAIN_MAX_COST=100000

# 报告外部推送（飞书群自定义机器人）
# Webhook 与签名密钥只能放在服务端，不得写入前端或提交真实值。
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
# 飞书企业自建应用网页 OAuth；回调地址必须同时登记在飞书开放平台安全设置中。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://127.0.0.1:8000/api/feishu/oauth/callback
FEISHU_AUTHORIZE_URL=https://accounts.feishu.cn/open-apis/authen/v1/authorize
FEISHU_OAUTH_STATE_TTL_SECONDS=600

# 飞书企业自建应用机器人（单聊双向问析，不是群自定义 Webhook 机器人）
# 在飞书开放平台启用机器人能力，使用长连接订阅 im.message.receive_v1，
# 并申请“读取用户发给机器人的单聊消息”和“以应用身份发消息”权限。
FEISHU_BOT_ENABLED=false
FEISHU_BOT_APP_ID=
FEISHU_BOT_APP_SECRET=
# 必须显式把飞书 open_id 绑定到 ForgeSight 业务账号与允许访问的数据源。
# 示例：{"ou_xxx":{"userId":"local-test-user","sourceId":1}}
FEISHU_BOT_BINDINGS_JSON={}
FEISHU_BOT_POLL_SECONDS=0.75
FEISHU_BOT_LEASE_SECONDS=360
FEISHU_BOT_MAX_ATTEMPTS=3
FEISHU_BOT_MAX_CONCURRENCY=4
FEISHU_BOT_RESULT_WAIT_SECONDS=30

# 钉钉企业内部应用（OAuth 绑定 + Stream 双向问析）
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_REDIRECT_URI=
# 钉钉授权地址模板需包含 {client_id}、{redirect_uri}、{state} 三个占位符。
DINGTALK_AUTHORIZE_URL_TEMPLATE=
DINGTALK_ROBOT_CODE=
DINGTALK_OAUTH_STATE_TTL_SECONDS=600
DINGTALK_BOT_POLL_SECONDS=0.75
DINGTALK_BOT_LEASE_SECONDS=360
DINGTALK_BOT_MAX_ATTEMPTS=3
DINGTALK_BOT_MAX_CONCURRENCY=4
DINGTALK_BOT_RESULT_WAIT_SECONDS=30
# 飞书卡片“查看报告”按钮跳转的前端公网地址；本地联调可保持默认。
PUBLIC_APP_URL=http://127.0.0.1:5173

# 建模模型文件存储目录（joblib 落盘，相对 backend/ 或绝对路径）
MODELING_STORAGE_DIR=modeling_artifacts

# 已发布周报 PDF/Excel 服务端存储目录（相对 backend/ 或绝对路径）
REPORT_STORAGE_DIR=report_artifacts

# 认证（用户注册登录）
# 生产必须改为随机长串，如 openssl rand -hex 32
AUTH_TOKEN_SECRET=CHANGE_ME
# token 有效期（秒），默认 7 天
AUTH_TOKEN_TTL_SECONDS=604800
# 种子管理员账号（首次启动自动创建；已存在则保持）
AUTH_ADMIN_USERNAME=admin
# 演示环境可设 admin123，生产必改
AUTH_ADMIN_PASSWORD=CHANGE_ME
AUTH_ADMIN_DISPLAY_NAME=系统管理员
# 默认要求登录并验证邮箱；本地 capture 会把验证码写入捕获目录，不会发送外部邮件
AUTH_EMAIL_GATE_ENABLED=true
# 新注册业务账号须绑定钉钉或飞书后方可进入工作台
AUTH_EXTERNAL_IDENTITY_GATE_ENABLED=true
AUTH_EMAIL_GATE_ALLOW_CAPTURE=true
# 仅本地演示需要时开启；门禁开启后匿名演示回退自动失效
DEMO_MODE_ENABLED=false

# 邮箱验证码（这里是验证码 HMAC 密钥，不是 QQ 邮箱 SMTP 授权码）
EMAIL_CODE_SECRET=CHANGE_ME
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_HOURLY_LIMIT_EMAIL=5
EMAIL_HOURLY_LIMIT_ACCOUNT=5
EMAIL_HOURLY_LIMIT_IP=10

# 通用邮件 Provider：本地/测试用 capture，生产用 smtp
MAIL_PROVIDER=capture
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ForgeSight
MAIL_TIMEOUT_SECONDS=10
MAIL_ATTACHMENT_MAX_BYTES=10485760
MAIL_MAX_ATTEMPTS=3
MAIL_WORKER_LEASE_SECONDS=60
# 飞书/钉钉周报 PDF 投递 Worker 重试与租约配置
IM_PDF_MAX_ATTEMPTS=3
IM_PDF_WORKER_LEASE_SECONDS=90

# SMTP（凭据仅写本地 .env 或部署密钥，不要提交到仓库）
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# 前端联调
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
